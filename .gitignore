# ==============================================================================
# QuoteFlow .gitignore
# Comprehensive rules for Root, Server (Express/Prisma), and Client (React/Vite)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets, Credentials, & Environment Variables (CRITICAL)
# ------------------------------------------------------------------------------
# Ignore all .env files across root and all subdirectories
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env

# Explicitly preserve template/example configuration files
!.env.example
!**/.env.example
!.env.template
!**/.env.template

# ------------------------------------------------------------------------------
# 2. Dependencies
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 3. Production Builds & Bundler Caches
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.vite/
**/.vite/
.parcel-cache/
.turbo/
.cache/

# ------------------------------------------------------------------------------
# 4. User Uploads & Media Assets
# ------------------------------------------------------------------------------
# Ignore uploaded files across root and subfolders (e.g. server/uploads)
uploads/*
server/uploads/*
**/uploads/*

# Preserve .gitkeep so empty directories remain tracked
!.gitkeep
!uploads/.gitkeep
!server/uploads/.gitkeep
!**/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 5. Database Files, WAL Logs, & Snapshots (SQLite, PostgreSQL dumps, backups)
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sql.gz
*.dump
*.backup
*.bak

# ------------------------------------------------------------------------------
# 6. Logs & Debugging
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 7. Operating System & Local Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ------------------------------------------------------------------------------
# 8. Editor & IDE Settings
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 9. Testing, Coverage, & Scratch Files
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
scratch/
**/scratch/
tmp/
**/tmp/
temp/
**/temp/
